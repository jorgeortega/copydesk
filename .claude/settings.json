{
  "permissions": {
    "allow": ["Bash(uv run:*)","Bash(uv add:*)","Bash(uv sync:*)","Bash(uv init:*)","Bash(git status)","Bash(git diff:*)","Bash(git add:*)","Bash(git commit:*)"],
    "deny": ["Read(./.env)","Read(./.env.local)"]
  },
  "hooks": {
    "PostToolUse": [{
      "matcher": "Edit|Write",
      "hooks": [{
        "type": "command",
        "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in *.py) uvx ruff format --quiet \"$f\";; esac; } 2>/dev/null || true",
        "timeout": 30
      }]
    }]
  }
}
